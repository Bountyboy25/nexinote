# Copy to `.env` (gitignored) and fill in.
# VITE_* values are inlined into the public bundle at BUILD time — never
# put anything genuinely secret here.

# Google Apps Script web-app URL that receives in-app feedback and
# appends it to a spreadsheet. Setup: feedback/README.md
# Leave unset and the feedback form degrades to copy-to-clipboard.
VITE_FEEDBACK_ENDPOINT=
